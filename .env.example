# equipo-10 - Supabase local configuration
# Fill values locally. Do not paste secrets into chat or commit this file.
# Server configuration contract is wired in D1.
# Setup: Web client uses scripts/prepare-web-env.mjs to generate apps/web/.env.local (git-ignored)
# containing ONLY the three allowlisted public VITE_ keys (VITE_SUPABASE_URL, VITE_SUPABASE_PUBLISHABLE_KEY, VITE_API_URL).
# Server credentials and database passwords must NEVER be copied or exposed to the client.

PORT=3001
HOST=127.0.0.1
WEB_ORIGIN="http://127.0.0.1:5173"

# Optional server public bootstrap input (defaults to http://127.0.0.1:3001 if omitted)
VITE_API_URL="http://127.0.0.1:3001"

# REQUIRED - Supabase dashboard > Project Settings > API / API Keys
# Project URL, e.g. https://your-project-ref.supabase.co
SUPABASE_URL=""
# Publishable key (sb_publishable_...). Legacy anon key only if applicable.
# This is NOT a service_role or secret key.
SUPABASE_PUBLISHABLE_KEY=""

# REQUIRED - Connection for application server runtime (NO OWNER privileges).
# Uses a dedicated login role (NOT owner) authorized exclusively to execute `SET LOCAL ROLE equipo10_runtime`.
# The group role `equipo10_runtime` has NOLOGIN and CANNOT be used as the URL connection username.
# Session pooler (port 5432) or direct connection. Server-only; never prefix with VITE_.
# DATABASE_URL and DIRECT_URL MUST be distinct roles/connections when deployed.
DATABASE_URL=""

# REQUIRED FOR MIGRATIONS/BOOTSTRAP - Connection for schema owner / migrator tooling.
# Direct connection preferred or Session pooler with schema owner / migrator privileges.
# Do NOT use Transaction pooler (port 6543) for this field.
# MUST be distinct from runtime DATABASE_URL; never run API runtime as the owner role.
DIRECT_URL=""

# No service_role, Supabase secret key, JWT signing secret, Google API key, or ADC
# is required for D1. Test fixtures use Docker port 55435 and hardcoded SYNTHETIC test
# credentials via their own helper. Do not add blank test direct URLs here.

# Public Supabase CA; application/driver must explicitly load this file.
DATABASE_SSL_CA_FILE="certs/supabase-prod-ca-2021.crt"
