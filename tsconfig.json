{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["bun", "vite/client"]
  },
  "include": ["apps", "packages", "tests"],
  "exclude": ["**/node_modules", "**/dist", "prisma/generated"]
}
