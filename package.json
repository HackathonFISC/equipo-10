{
  "name": "equipo-10",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": { "node": ">=24.11.0 <25" },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "bun --env-file=.env --watch apps/api/src/server.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "build": "vite build --config apps/web/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test:api": "bun test tests/api",
    "test:identity": "node scripts/test-identity-db.mjs",
    "test:e2e": "playwright test",
    "setup:web": "node --env-file=.env scripts/prepare-web-env.mjs",
    "db:validate": "node --env-file-if-exists=.env node_modules/prisma/build/index.js validate",
    "db:format": "node --env-file-if-exists=.env node_modules/prisma/build/index.js format",
    "db:generate": "node --env-file-if-exists=.env node_modules/prisma/build/index.js generate",
    "test:schema": "node scripts/test-schema.mjs",
    "test:runtime-access": "node scripts/test-runtime-access.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.4.3",
    "@playwright/test": "1.64.1",
    "@types/bun": "1.3.14",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "prisma": "7.10.1",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
