# Credenciales locales; conservar el ejemplo sin secretos.
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx
application_default_credentials.json
service-account*.json

# Dependencias, cliente Prisma y compilados reproducibles.
node_modules/
node_modules.*/
generated/
dist/
*.tsbuildinfo

# Resultados de pruebas y caches locales.
playwright-report/
test-results/
coverage/
.cache/
.vite/
.runtime/
storage/
*.log

# Herramientas y registros internos de desarrollo, fuera de la entrega.
